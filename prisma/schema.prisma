generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is removed here for Prisma 7+
}

model User {
  id      String   @id @default(uuid())
  email   String   @unique
  name    String?
  image   String?
  clerkId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}